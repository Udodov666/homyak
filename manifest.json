{
  "manifest_version": 3,
  "name": "Хомобот",
  "version": "1.3.2",
  "description": "Отвечает за тебя на форуме — в стиле любительХомиака",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "host_permissions": [
    "https://www.fastaitoken.com/*",
    "https://fastaitoken.com/*"
  ],
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Хомобот",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://lolz.team/*",
        "https://www.lolz.team/*",
        "https://lolz.live/*",
        "https://www.lolz.live/*",
        "https://lzt.market/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ]
}
